# Copy to .env (`cp docs/env.example .env.example` for the tracked template, `cp docs/env.example .env` for your real file) and fill in.
# .env is git-ignored; never commit it or paste its contents anywhere.

# Neo4j (database `watchline`)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=watchline

# Geosupport sidecar (default shown; only set to change)
# GEOSUPPORT_URL=http://localhost:8081

# Anthropic: two separate keys, so spend can be told apart in the Console. The generic ANTHROPIC_API_KEY is not read.
AGENT_ANTHROPIC_API_KEY=      # the agent in `make chat`, `make ui` and the notebooks
EVAL_ANTHROPIC_API_KEY=       # `make eval-agent`: the agent under test and the judge. The eval runner refuses to start without it.

# Models (defaults shown)
# AGENT_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-haiku-5-5

# Eval safety limits (defaults shown; docs/plans/eval-cost.md). A live eval run stops when any is reached.
# EVAL_MAX_USD=0.25             estimated spend for the whole run, from logged tokens and watchline/evals/pricing.py
# EVAL_MAX_CALLS=12             model calls per case
# EVAL_CASE_TIMEOUT_S=90        seconds per case
# EVAL_JUDGE_MAX_CHARS=12000    records text sent to the judge per rubric item; longer is cut and the cut is logged
# EVAL_JUDGE=1                  turn the LLM judge on (off by default)
